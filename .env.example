# Copia este archivo como .env.local y pon los datos de tu proyecto de Supabase
# (Supabase -> Project Settings -> API). La clave "anon" es pública: la protección
# real son las políticas RLS de supabase/esquema.sql y la sesión de la cuenta del local.
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon
